# ==============================================================================
# NEXORA AI — ENVIRONMENT CONFIGURATION & SECRETS TEMPLATE
# Copy this file to .env and replace placeholders with actual values.
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# --- System & Deployment Environment ---
NEXORA_ENV=development                       # Options: development, staging, production
NEXORA_LOG_LEVEL=INFO                         # Options: DEBUG, INFO, WARNING, ERROR
NEXORA_SECRET_KEY=nexora-super-secret-jwt-signing-key-change-in-production-min-32-chars!

# --- PostgreSQL & pgvector Database Settings ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexora_db
POSTGRES_USER=nexora_admin
POSTGRES_PASSWORD=nexora_secure_password_2026

# --- Redis Caching & Queue Settings ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nexora_redis_password_2026
REDIS_DB=0

# --- Vector Database Settings (Qdrant / FAISS) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=nexora_qdrant_api_key_2026
VECTOR_DB_TYPE=qdrant                         # Options: qdrant, faiss, pgvector

# --- FastAPI Microservice Settings ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# --- Spring Boot Enterprise Backend Settings ---
SPRING_PORT=8080
SPRING_PROFILE=dev
JWT_EXPIRATION_MS=86400000                     # 24 hours in milliseconds
REFRESH_TOKEN_EXPIRATION_MS=604800000          # 7 days in milliseconds

# --- LLM Provider API Keys & Settings ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
LLM_DEFAULT_MODEL=gpt-4o-mini                 # Options: gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-pro, local-ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings & Vector Search Settings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Speech-to-Text & Text-to-Speech Settings ---
WHISPER_MODEL_SIZE=small                       # Options: tiny, base, small, medium, large-v3
COQUI_TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/your_tts

# --- Computer Vision & 3D-CNN Model Settings ---
GESTURE_MODEL_PATH=ml/models/weights/3d_cnn_gesture_v1.pt
VISION_CONFIDENCE_THRESHOLD=0.75

# --- FastMCP Tool Protocol Settings ---
MCP_SERVER_PORT=8001
MCP_ENABLE_HIGH_RISK_CONFIRMATION=true

# --- Location & Maps Services ---
GOOGLE_MAPS_API_KEY=AIzaSy-your-google-maps-api-key-here

# --- Payment Gateway (Stripe Test Keys) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# --- MLOps & Experiment Tracking (MLflow) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nexora_3d_cnn_gestures

# --- Observability & Monitoring ---
PROMETHEUS_METRICS_PORT=9090
OPENTELEMETRY_ENDPOINT=http://localhost:4317
